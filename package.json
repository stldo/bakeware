{
  "name": "bakeware",
  "version": "0.1.0",
  "author": "stldo (https://github.com/stldo)",
  "description": "Utility library handling the basic ingredients of styling, built to work alongside vanilla-extract",
  "keywords": [
    "animation",
    "breakpoints",
    "css",
    "css-in-js",
    "css-layers",
    "css-utils",
    "font-face",
    "layer",
    "media-queries",
    "normalize",
    "rhythm",
    "spacing",
    "styling",
    "transition",
    "type-scale",
    "typography",
    "vanilla-extract",
    "vertical-rhythm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stldo/bakeware.git"
  },
  "dependencies": {
    "@colordx/core": "^5.7.0",
    "url-slug": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "csstype": "^3.2.3",
    "es-check": "^9.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "type-fest": "^5.9.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "@vanilla-extract/css": "^1.21.2",
    "csstype": "^3.2.3",
    "type-fest": "^5.8.0"
  },
  "exports": {
    "./alpha": {
      "import": "./dist/alpha.mjs",
      "require": "./dist/alpha.cjs"
    },
    "./animation": {
      "import": "./dist/animation.mjs",
      "require": "./dist/animation.cjs"
    },
    "./breakpoints": {
      "import": "./dist/breakpoints.mjs",
      "require": "./dist/breakpoints.cjs"
    },
    "./create-theme": {
      "import": "./dist/create-theme.mjs",
      "require": "./dist/create-theme.cjs"
    },
    "./font-face": {
      "import": "./dist/font-face.mjs",
      "require": "./dist/font-face.cjs"
    },
    "./global-styles": {
      "import": "./dist/global-styles.mjs",
      "require": "./dist/global-styles.cjs"
    },
    "./normalize": {
      "import": "./dist/normalize.mjs",
      "require": "./dist/normalize.cjs"
    },
    "./spacing": {
      "import": "./dist/spacing.mjs",
      "require": "./dist/spacing.cjs"
    },
    "./transition": {
      "import": "./dist/transition.mjs",
      "require": "./dist/transition.cjs"
    },
    "./type-scale": {
      "import": "./dist/type-scale.mjs",
      "require": "./dist/type-scale.cjs"
    },
    "./vertical-rhythm": {
      "import": "./dist/vertical-rhythm.mjs",
      "require": "./dist/vertical-rhythm.cjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check": "npm run check:cjs && npm run check:mjs && npm run check:publint",
    "check:cjs": "es-check es2022 './dist/*.cjs'",
    "check:mjs": "es-check es2022 './dist/*.mjs' --module",
    "check:publint": "publint",
    "format": "biome check --no-errors-on-unmatched --write",
    "lint": "biome check --no-errors-on-unmatched",
    "postversion": "git push && git push --tags",
    "prepack": "npm run validate",
    "prepare": "husky",
    "preversion": "npm run validate",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run build && npm run check"
  }
}
